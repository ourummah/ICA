# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
ANTHROPIC_API_KEY=                # server only
ANTHROPIC_MODEL=                  # optional; defaults to claude-opus-5-5
AI_TRANSLATE_FAKE=false           # tests only: labelled stand-in translator when no API key is set
RESEND_API_KEY=                   # optional, demo-request emails
DEMO_REQUEST_NOTIFY_EMAIL=        # where demo-request emails go (comma-separated)
DEMO_REQUEST_FROM_EMAIL=          # optional; a sender on a domain verified in Resend
DEMO_FAST_TIMERS=false
SHOW_PRICING=false
DEMO_STAFF_PASSWORD=             # required when seeding a hosted Supabase project
# Blockchain anchoring (docs/AUDIT_TRAIL.md). Base Sepolia only. All server only.
ANCHOR_PRIVATE_KEY=               # anchor wallet key (0x...). Never commit; set in Vercel and GitHub secrets
ANCHOR_CONTRACT_ADDRESS=          # from the "Deploy anchor contract" workflow
ANCHOR_RPC_URL=                   # optional; defaults to https://sepolia.base.org
ANCHOR_ALERT_EMAIL=               # optional; failure/low-balance alerts (uses RESEND_API_KEY)
ANCHOR_MIN_BALANCE_ETH=           # optional; low-balance alert threshold, default 0.002
CRON_SECRET=                      # Vercel Cron bearer token for /api/cron/anchor
PUBLIC_SITE_URL=                  # optional; base URL for verify links in audit pack QR codes
